# PostgreSQL (local Docker example: docker compose up -d db)
POSTGRES_USER="careertwin"
POSTGRES_PASSWORD="change-this-local-database-password"
POSTGRES_DB="careertwin"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://careertwin:change-this-local-database-password@localhost:5432/careertwin?schema=public"

# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Gemini is the primary production AI provider.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite"

# Optional OpenAI-compatible fallback.
AI_API_URL=""
AI_API_KEY=""
AI_MODEL=""

# Public URL used in Cloud Run/Vercel.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
