{
  "name": "careertwin-web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.ts",
    "ai:test": "node --env-file=.env scripts/test-ai-models.mjs",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "fetch:figma": "node scripts/fetch-figma-frames.mjs",
    "predev": "node scripts/fetch-figma-frames.mjs",
    "prebuild": "node scripts/fetch-figma-frames.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "latest",
    "jose": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prisma": "^6.12.0",
    "typescript": "latest"
  },
  "prisma": {
    "seed": "node prisma/seed.ts"
  }
}
