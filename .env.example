# Supabase Postgres. Use the shared transaction pooler for the application.
# URL-encode reserved password characters (for example, @ becomes %40).
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use the shared session pooler for Prisma migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Gemini is the primary production AI provider.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite"

# Optional OpenAI-compatible fallback.
AI_API_URL=""
AI_API_KEY=""
AI_MODEL=""

# Public URL used in Cloud Run/Vercel.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
